# Supabase project settings
# Find both values in Supabase Dashboard → Project Settings → API,
# or in the project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only. Never prefix this value with NEXT_PUBLIC_.
# Create/copy it from Supabase Dashboard → Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Optional scheduled knowledge worker. Use a long random server-only value.
SUGAR_KNOWLEDGE_WORKER_SECRET=replace_with_a_long_random_secret

# Feishu enterprise Wiki connector. Server only; never prefix these with NEXT_PUBLIC_.
# Create an enterprise custom app, grant Wiki, Docx and Drive access plus the
# read permissions for Sheets/Bitable when those file types should be indexed.
# Publish it, then add the app as a member/admin of the selected Wiki space.
FEISHU_APP_ID=cli_your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
# Optional legacy defaults. New connections are added by pasting a Wiki URL in the UI.
FEISHU_SPACE_ID=
FEISHU_ROOT_NODE_TOKEN=
# Optional but recommended so the UI can return clickable source links.
FEISHU_TENANT_URL=https://your-workspace.feishu.cn
# Required only when enabling the Feishu event callback.
FEISHU_VERIFICATION_TOKEN=your_feishu_event_verification_token

# Optional controlled client-delivery channels. Never expose these variables to the browser.
RESEND_API_KEY=re_replace_with_resend_server_key
SUGAR_DELIVERY_FROM_EMAIL=Sugar Studio <noreply@example.com>
SUGAR_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace_with_webhook_key

# Trusted local Node.js Codex runner. The web application never starts Git or Codex processes.
# For deployed Sugar Agent, use device transport. For local development, direct mode keeps the existing loopback runner flow.
SUGAR_RUNNER_TRANSPORT=device
SUGAR_CODEX_RUNNER_URL=http://127.0.0.1:4391
SUGAR_CODEX_RUNNER_SECRET=replace_with_a_long_random_secret

# Runner process only. Separate multiple allowed repository roots with the OS path delimiter.
SUGAR_CODEX_RUNNER_HOST=127.0.0.1
SUGAR_CODEX_RUNNER_PORT=4391
SUGAR_LOCAL_REPOSITORY_ROOTS=/Users/your-name/Projects
# Jobs are refused unless the host explicitly declares this trusted boundary.
SUGAR_RUNNER_ISOLATED=false

# Optional public download location shown in Account Settings after the signed installer is uploaded.
NEXT_PUBLIC_SUGAR_RUNNER_DOWNLOAD_URL=https://downloads.example.com/Sugar-Runner-macOS-arm64.dmg

# 1688 云牛顿 OpenAPI. Server only; never use NEXT_PUBLIC_ prefixes.
NEWTON_APP_KEY=your_newton_app_key
NEWTON_APP_SECRET=your_newton_app_secret
NEWTON_ACCESS_TOKEN=your_newton_access_token
